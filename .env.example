STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Google sign-in — create a "Desktop app" OAuth client in Google Cloud Console.
# Both values come from that client (desktop app secrets are not confidential).
GOOGLE_CLIENT_ID=your_desktop_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_desktop_oauth_client_secret_here

# Android native Google sign-in (Web OAuth client ID used as the ID-token
# audience). Register the Android app package + SHA-1 in Google Cloud Console.
GOOGLE_SERVER_CLIENT_ID=your_google_web_client_id_here

# Email delivery (Resend) - set a real key in .env, never commit it
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional: override the in-app update feed (JSON with GitHub release shape).
# Default: https://api.github.com/repos/mosisgemechis/inventory_management/releases/latest
# UPDATE_FEED_URL=
