# Backend Environment Configuration
# Copy this file to backend/.env and fill in real values
# NEVER commit backend/.env to version control

# PostgreSQL connection string (no credentials should appear here)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/inventory_db

# Application secrets
JWT_SECRET=your_secure_jwt_secret_here

# Server settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Email delivery (Resend) - set a real key in .env, never commit it
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
